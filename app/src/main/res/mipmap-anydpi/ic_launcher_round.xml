    <item>
        <shape android:shape="oval">
            <solid android:color="#160B2B" />
        </shape>
    </item>
    <item
        android:width="62dp"
        android:height="62dp"
        android:drawable="@drawable/emogy_logo"
        android:gravity="center" />
</layer-list>
