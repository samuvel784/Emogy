<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher foreground (API 26+): the Emogy logo centred in the safe zone.
     The logo has transparent outer corners so the gradient background shows through the mask. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="72dp"
        android:height="72dp"
        android:drawable="@drawable/emogy_logo"
        android:gravity="center" />
</layer-list>
