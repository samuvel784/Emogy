# Normalise line endings so Windows and macOS/Linux contributors produce clean diffs.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jar binary
*.jks binary
*.keystore binary
